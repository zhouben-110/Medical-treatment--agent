LLM_API_KEY=your-dashscope-api-key-here
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medical_agent
EMBEDDING_MODEL=text-embedding-v3
DATA_DIR=./data

# Security settings
API_KEY=your-secret-api-key-here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
SQL_ECHO=false

# LangSmith 追踪（默认关闭，防止患者医疗数据外泄到云端）
# 如需调试，临时开启并确保使用自托管 LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=medical-agent

REDIS_URL=redis://localhost:6379/0

# Medical-KB MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Supabase 配置（用于 JWT 验证）
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here  # 在 Supabase Dashboard > Settings > API > JWT Secret 获取
